{
  "type": "json_schema",
  "json_schema": {
    "name": "event_duplicates",
    "strict": true,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results"
      ],
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "outcome"
            ],
            "properties": {
              "index": {
                "type": "integer"
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "existing",
                  "possible_duplicate",
                  "no_match"
                ]
              }
            }
          }
        }
      }
    }
  }
}
